<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="fieldparams">
        <fieldset
                name="fieldparams"
                addfieldprefix="Joomill\Plugin\Fields\Youtube\Field"
        >

            <field
                    name="video_width"
                    type="text"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_VIDEO_WIDTH_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_VIDEO_WIDTH_DESC"
                    size="40"
                    default="100%"
            />

            <field
                    name="video_height"
                    type="text"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_VIDEO_HEIGHT_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_VIDEO_HEIGHT_DESC"
                    size="40"
            />

            <field
                    name="nocookie"
                    type="radio"
                    class="btn-group btn-group-yesno"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_NOCOOKIE_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_NOCOOKIE_DESC"
                    default="0"
            >
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>

            <field
                    name="responsive"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_MODE_RESPONSIVE"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_MODE_DESC"
            />

            <field
                    name="lite"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_LITE_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_LITE_DESC"
            />

            <field
                    name="align"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_ALIGN_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_ALIGN_DESC"
            />

            <field
                    name="autoplay"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_AUTOPLAY_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_AUTOPLAY_DESC"
            />

            <field
                    name="mute"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_MUTE_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_MUTE_DESC"
            />

            <field
                    name="controls"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_CONTROLS_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_CONTROLS_DESC"
            />

            <field
                    name="color"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_COLOR_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_COLOR_DESC"
            />

            <field
                    name="modestbranding"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_MODESTBRANDING_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_MODESTBRANDING_DESC"
            />

            <field
                    name="fullscreen"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_FULLSCREEN_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_FULLSCREEN_DESC"
            />

            <field
                    name="rel"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_REL_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_REL_DESC"
            />

            <field
                    name="captions"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_CAPTIONS_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_CAPTIONS_DESC"
            />

            <field
                    name="playsinline"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_PLAYSINLINE_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_PLAYSINLINE_DESC"
            />

            <field
                    name="loop"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_LOOP_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_LOOP_DESC"
            />

            <field
                    name="start"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_START_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_START_DESC"
            />

            <field
                    name="end"
                    type="pro"
                    label="PLG_FIELDS_YOUTUBE_PARAMS_END_LABEL"
                    description="PLG_FIELDS_YOUTUBE_PARAMS_END_DESC"
            />

            <field
                    name=""
                    type="upgrade"
            />

        </fieldset>
    </fields>
</form>
